# Database Settings (Local MySQL via Docker Compose or Remote MySQL / SQLite fallback)
DATABASE_URL=mysql+pymysql://news_user:news_password@localhost:3306/ai_news

# LLM Configuration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Email / SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=AI News Digest <your_email@gmail.com>
EMAIL_TO=recipient@example.com

# Ingestion Settings
DEFAULT_MAX_ITEMS_PER_FEED=5

# RSS Feed URLs (comma-separated list)
BLOG_FEEDS=https://openai.com/news/rss.xml,https://huggingface.co/blog/feed.xml,https://blog.google/technology/ai/rss/
YOUTUBE_CHANNELS=UCbfYPyITQ-shared
